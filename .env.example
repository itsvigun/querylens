# Local demo settings only. Choose a local password before starting PostgreSQL.
POSTGRES_USER=querylens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=querylens
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
API_PORT=8000
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000

# Separate login roles. Choose distinct passwords of at least 16 characters.
ANALYTICS_READONLY_PASSWORD=change-me-readonly-local
KNOWLEDGE_WRITER_PASSWORD=change-me-knowledge-local
KNOWLEDGE_READONLY_PASSWORD=change-me-knowledge-reader
SQL_MAX_ROWS=1000
SQL_MAX_RESULT_BYTES=65536
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_TOOL_TIMEOUT_MS=10000

# Docker Compose overrides the API database host/port to db:5432.
# Embedding settings are independent of the LLM provider.
# Add a real server-side key for live ingestion/search; dry-run and tests need none.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_INDEX_VERSION=v1
KNOWLEDGE_INDEX_NAME=default
EMBEDDING_TIMEOUT_SECONDS=20

# Responses API. No provider calls during startup or health checks.
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_CALLS=6
LLM_MAX_TOOL_CALLS=8
LLM_MAX_SQL_CALLS=3
LLM_MAX_SQL_REPAIRS=2
LLM_MAX_INPUT_BYTES=128000
LLM_MAX_OUTPUT_TOKENS=4000
