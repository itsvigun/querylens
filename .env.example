# Local demo settings only. Choose a local password before starting PostgreSQL.
POSTGRES_USER=querylens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=querylens
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
API_PORT=8000
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000

# Separate login roles. Choose distinct passwords of at least 16 characters.
ANALYTICS_READONLY_PASSWORD=change-me-readonly-local
KNOWLEDGE_WRITER_PASSWORD=change-me-knowledge-local

# Docker Compose overrides the API database host/port to db:5432.
# No LLM API key is required for stages 0 and 1.
